{
  "name": "@openmatel/core",
  "version": "0.1.0",
  "description": "Canonical agent event schema (oma.agentobs.v1) and ports for OpenMaTel.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./idle": {
      "types": "./dist/idle.d.ts",
      "default": "./dist/idle.js"
    },
    "./llm": {
      "types": "./dist/llm.d.ts",
      "default": "./dist/llm.js"
    },
    "./tree": {
      "types": "./dist/tree.d.ts",
      "default": "./dist/tree.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b"
  },
  "engines": {
    "node": ">=22.13"
  }
}
